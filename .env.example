# Enom reseller API credentials (interface.asp).
# NOTE: Enom API access requires your public IP to be whitelisted in the
# reseller control panel (Settings -> API Settings), or every call fails auth.
ENOM_UID=your-enom-login-id
ENOM_PW=your-enom-password-or-api-token
# prod = reseller.enom.com, test = resellertest.enom.com
ENOM_ENV=prod

# Cloudflare API token with Zone:Read, Zone:Edit, DNS:Edit on the account.
CF_API_TOKEN=your-cloudflare-api-token
# Needed to create zones (dash.cloudflare.com -> account home -> Account ID).
CF_ACCOUNT_ID=your-cloudflare-account-id
